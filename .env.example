# Study middleware (docker-compose.yml in this repo)
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ai_fusion_video
MYSQL_USER=fusion
MYSQL_PASSWORD=123456
MYSQL_PORT=43306

REDIS_PASSWORD=123456
REDIS_PORT=46379

# Go server
HTTP_ADDR=:18080
DATABASE_URL=fusion:123456@tcp(127.0.0.1:43306)/ai_fusion_video?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:46379
FFMPEG_PATH=ffmpeg

# development 默认 text；production 默认 json。LOG_FORMAT 可显式覆盖为 text 或 json。
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
